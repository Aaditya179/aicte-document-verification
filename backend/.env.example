# Same Supabase project as Nirikshan; ProofPath's tables are in the `proofpath` schema
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_minimum_32_characters_here
SUPABASE_SCHEMA=proofpath
STORAGE_BUCKET=proofpath-documents
MAX_UPLOAD_MB=15
MAX_PAGES=50

# Read scanned pages with Tesseract (install it first: brew install tesseract)
OCR_ENABLED=false

# Date the checks compare against: `today`, or `fixed` with AS_OF_DATE (YYYY-MM-DD) for reproducible demos
AS_OF_DATE_MODE=today
AS_OF_DATE=

FRONTEND_ORIGIN=http://localhost:3001
# Optional regex of extra CORS origins, e.g. Vercel previews: https://proofpath-.*\.vercel\.app
CORS_ORIGIN_REGEX=
PORT=8001
DEMO_PASSWORD=password123

# Reviewer and rule admin routes require an aal2 (TOTP) session.
# DEMO_MFA_BYPASS lets demo accounts skip it except the listed ones. Never enable in production.
DEMO_MFA_BYPASS=false
DEMO_MFA_ENFORCED_EMAILS=

# Groq LLM. The failsafe key is tried when the default key fails. With no key, AI runs in mock mode.
GROQ_API_KEY=your_default_groq_key_here
GROQ_API_KEY_FAILSAFE=your_failsafe_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
